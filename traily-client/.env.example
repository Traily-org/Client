# Your machine's LAN IP, used so Expo Go on a physical device can reach
# the dev server running in Docker. Find yours with:
#   macOS: ipconfig getifaddr en0
#   Windows (PowerShell): ipconfig | findstr IPv4
#   Linux: hostname -I
REACT_NATIVE_PACKAGER_HOSTNAME=

# MapTiler API key (https://cloud.maptiler.com/account/keys/). Ships in the
# client bundle: restrict it to the app in the MapTiler dashboard.
EXPO_PUBLIC_MAPTILER_KEY=
# MapTiler legal notices (logo + always-visible attribution). Required on the
# free plan — only set to false with a paid plan / written MapTiler agreement.
EXPO_PUBLIC_MAPTILER_LEGAL_NOTICES=
