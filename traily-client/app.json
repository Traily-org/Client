{
    "expo": {
        "name": "traily-client",
        "slug": "traily-client",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "trailyclient",
        "userInterfaceStyle": "automatic",
        "android": {
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
