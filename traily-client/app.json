{
    "expo": {
        "name": "traily-client",
        "slug": "traily-client",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "trailyclient",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.traily.app"
        },
        "android": {
            "package": "com.traily.app",
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF"
                }
            ],
            "@maplibre/maplibre-react-native"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
