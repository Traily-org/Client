{
    "expo": {
        "name": "traily-client",
        "slug": "traily",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "trailyclient",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.traily.app"
        },
        "android": {
            "package": "com.traily.app",
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200
                }
            ],
            "@maplibre/maplibre-react-native"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "5456da5b-5065-4521-85f8-7cbe000930b6"
            }
        },
        "owner": "traily-epitech"
    }
}
