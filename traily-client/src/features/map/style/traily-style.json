{
    "version": 8,
    "name": "Traily",
    "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
    "sprite": "https://protomaps.github.io/basemaps-assets/sprites/v4/light",
    "sources": {
        "protomaps": {
            "type": "vector",
            "url": "pmtiles://PLACEHOLDER",
            "attribution": "© OpenStreetMap contributors, © Protomaps"
        }
    },
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#f6f1e4"
            }
        },
        {
            "id": "earth",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "earth",
            "paint": {
                "fill-color": "#f6f1e4"
            }
        },
        {
            "id": "landcover-natural",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "landcover",
            "filter": ["in", "kind", "forest", "grassland", "scrub"],
            "paint": {
                "fill-color": [
                    "match",
                    ["get", "kind"],
                    "forest",
                    "#cddfc6",
                    "grassland",
                    "#e3ecd7",
                    "scrub",
                    "#e6ecd9",
                    "#e3ecd7"
                ],
                "fill-opacity": 0.7
            }
        },
        {
            "id": "landuse-park",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "landuse",
            "filter": [
                "in",
                "kind",
                "park",
                "nature_reserve",
                "national_park",
                "protected_area",
                "cemetery"
            ],
            "paint": {
                "fill-color": "#b9d7a8",
                "fill-opacity": 0.6
            }
        },
        {
            "id": "landuse-urban",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "landuse",
            "filter": ["in", "kind", "residential", "commercial", "industrial"],
            "paint": {
                "fill-color": "#ece3d1",
                "fill-opacity": 0.5
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "water",
            "filter": ["==", ["geometry-type"], "Polygon"],
            "paint": {
                "fill-color": "#8fc4d1"
            }
        },
        {
            "id": "water-line",
            "type": "line",
            "source": "protomaps",
            "source-layer": "water",
            "filter": ["==", ["geometry-type"], "LineString"],
            "paint": {
                "line-color": "#8fc4d1",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    10,
                    0.5,
                    16,
                    2
                ]
            }
        },
        {
            "id": "boundaries",
            "type": "line",
            "source": "protomaps",
            "source-layer": "boundaries",
            "filter": ["<=", ["get", "min_zoom"], 4],
            "paint": {
                "line-color": "#a68a64",
                "line-width": 1,
                "line-dasharray": [3, 2]
            }
        },
        {
            "id": "roads-path",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "path"],
            "minzoom": 13,
            "paint": {
                "line-color": "#c98a4b",
                "line-width": 1,
                "line-dasharray": [2, 2]
            }
        },
        {
            "id": "roads-minor",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["in", "kind", "minor_road", "minor_service"],
            "minzoom": 12,
            "paint": {
                "line-color": "#d8cbb0",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    12,
                    0.5,
                    18,
                    3
                ]
            }
        },
        {
            "id": "roads-major",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "major_road"],
            "minzoom": 8,
            "paint": {
                "line-color": "#e8a24d",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    8,
                    0.8,
                    18,
                    5
                ]
            }
        },
        {
            "id": "roads-highway",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "highway"],
            "minzoom": 5,
            "paint": {
                "line-color": "#e0733f",
                "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 7]
            }
        },
        {
            "id": "buildings",
            "type": "fill",
            "source": "protomaps",
            "source-layer": "buildings",
            "minzoom": 15,
            "paint": {
                "fill-color": "#d9c9a8",
                "fill-outline-color": "#c2ac80"
            }
        },
        {
            "id": "roads-major-label",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["in", "kind", "highway", "major_road"],
            "minzoom": 10,
            "layout": {
                "symbol-placement": "line",
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Regular"],
                "text-size": 12
            },
            "paint": {
                "text-color": "#8a4a26",
                "text-halo-color": "#f6f1e4",
                "text-halo-width": 1.2
            }
        },
        {
            "id": "places-locality",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "places",
            "filter": ["==", ["get", "kind"], "locality"],
            "minzoom": 8,
            "layout": {
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Regular"],
                "text-size": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    8,
                    10,
                    16,
                    16
                ]
            },
            "paint": {
                "text-color": "#3d2b1f",
                "text-halo-color": "#f6f1e4",
                "text-halo-width": 1.4
            }
        },
        {
            "id": "places-region",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "places",
            "filter": ["in", "kind", "region", "country"],
            "maxzoom": 8,
            "layout": {
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Medium"],
                "text-size": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    2,
                    11,
                    8,
                    15
                ],
                "text-letter-spacing": 0.05
            },
            "paint": {
                "text-color": "#5c3b23",
                "text-halo-color": "#f6f1e4",
                "text-halo-width": 1.4
            }
        }
    ]
}
