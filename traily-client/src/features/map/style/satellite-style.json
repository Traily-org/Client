{
    "version": 8,
    "name": "Traily Satellite",
    "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
    "sprite": "https://protomaps.github.io/basemaps-assets/sprites/v4/light",
    "sources": {
        "esri-satellite": {
            "type": "raster",
            "tiles": [
                "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
            ],
            "tileSize": 256,
            "maxzoom": 19,
            "attribution": "Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
        },
        "protomaps": {
            "type": "vector",
            "url": "pmtiles://PLACEHOLDER",
            "attribution": "© OpenStreetMap contributors, © Protomaps"
        },
        "route": {
            "type": "geojson",
            "data": { "type": "FeatureCollection", "features": [] }
        }
    },
    "layers": [
        {
            "id": "esri-satellite",
            "type": "raster",
            "source": "esri-satellite"
        },
        {
            "id": "boundaries",
            "type": "line",
            "source": "protomaps",
            "source-layer": "boundaries",
            "filter": ["<=", ["get", "min_zoom"], 4],
            "paint": {
                "line-color": "#ffffff",
                "line-width": 1,
                "line-dasharray": [3, 2],
                "line-opacity": 0.8
            }
        },
        {
            "id": "roads-path",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "path"],
            "minzoom": 13,
            "paint": {
                "line-color": "#fff066",
                "line-width": 1.4,
                "line-dasharray": [2, 2]
            }
        },
        {
            "id": "roads-major",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "major_road"],
            "minzoom": 8,
            "paint": {
                "line-color": "#ffb454",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    8,
                    0.8,
                    18,
                    5
                ]
            }
        },
        {
            "id": "roads-highway",
            "type": "line",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["==", ["get", "kind"], "highway"],
            "minzoom": 5,
            "paint": {
                "line-color": "#ff9800",
                "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 7]
            }
        },
        {
            "id": "route-casing",
            "type": "line",
            "source": "route",
            "layout": { "line-join": "round", "line-cap": "round" },
            "paint": {
                "line-color": "#ffffff",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    10,
                    3,
                    18,
                    8
                ],
                "line-opacity": 0.9
            }
        },
        {
            "id": "route-line",
            "type": "line",
            "source": "route",
            "layout": { "line-join": "round", "line-cap": "round" },
            "paint": {
                "line-color": "#ff3b30",
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    10,
                    1.5,
                    18,
                    5
                ]
            }
        },
        {
            "id": "roads-major-label",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "roads",
            "filter": ["in", "kind", "highway", "major_road"],
            "minzoom": 10,
            "layout": {
                "symbol-placement": "line",
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Regular"],
                "text-size": 12
            },
            "paint": {
                "text-color": "#ffffff",
                "text-halo-color": "#000000",
                "text-halo-width": 1.2
            }
        },
        {
            "id": "places-locality",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "places",
            "filter": ["==", ["get", "kind"], "locality"],
            "minzoom": 8,
            "layout": {
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Regular"],
                "text-size": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    8,
                    10,
                    16,
                    16
                ]
            },
            "paint": {
                "text-color": "#ffffff",
                "text-halo-color": "#000000",
                "text-halo-width": 1.4
            }
        },
        {
            "id": "places-region",
            "type": "symbol",
            "source": "protomaps",
            "source-layer": "places",
            "filter": ["in", "kind", "region", "country"],
            "maxzoom": 8,
            "layout": {
                "text-field": ["get", "name"],
                "text-font": ["Noto Sans Medium"],
                "text-size": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    2,
                    11,
                    8,
                    15
                ],
                "text-letter-spacing": 0.05
            },
            "paint": {
                "text-color": "#ffffff",
                "text-halo-color": "#000000",
                "text-halo-width": 1.4
            }
        }
    ]
}
